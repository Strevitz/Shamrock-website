# Netlify -> Site configuration -> Environment variables

# Publiczne (trafiają do przeglądarki)
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_...

# Tylko serwer (funkcje Netlify)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
STRIPE_SECRET_KEY=rk_live_...
RESEND_API_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...        # cena 19 zł / miesiąc
SITE_URL=https://shamrockbarber.com

# Dostawca poczty transakcyjnej (przykład: Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=...                    # sekret SMTP, nie hasło do skrzynki
MAIL_FROM=klub@mail.shamrockbarber.com
MAIL_TO=info@shamrockbarber.com
