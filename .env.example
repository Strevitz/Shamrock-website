# Netlify -> Site configuration -> Environment variables

# Publiczne (trafiają do przeglądarki)
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=...

# Tylko serwer (funkcje Netlify)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...        # cena 19 zł / miesiąc
SITE_URL=https://shamrockbarber.com

# E-mail z info@shamrockbarber.com (SMTP, np. Zoho: smtp.zoho.eu, port 465)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=info@shamrockbarber.com
SMTP_PASS=...                    # hasło aplikacji
